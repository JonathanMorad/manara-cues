rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function isAdmin() {
      return signedIn() && exists(userPath(request.auth.uid)) &&
        get(userPath(request.auth.uid)).data.isAdmin == true;
    }
    function prodPath(pid) { return /databases/$(database)/documents/productions/$(pid); }
    function prod(pid) { return get(prodPath(pid)).data; }
    function isMember(pid) {
      return signedIn() && (isAdmin() ||
        (exists(prodPath(pid)) && request.auth.uid in prod(pid).memberIds));
    }
    function hasRole(pid, role) {
      return isMember(pid) && request.auth.uid in prod(pid).members &&
        prod(pid).members[request.auth.uid].hasAny([role]);
    }
    function canDirect(pid) { return isAdmin() || hasRole(pid, 'director'); }
    function eventPath(pid, eid) {
      return /databases/$(database)/documents/productions/$(pid)/events/$(eid);
    }
    function canReadEvent(pid, eid) {
      return isMember(pid) && exists(eventPath(pid, eid)) &&
        (canDirect(pid) || request.auth.uid in get(eventPath(pid, eid)).data.memberIds);
    }
    function validPublicShow(sid) {
      return request.resource.data.keys().hasOnly(
          ['id', 'pid', 'kind', 'title', 'startsAt', 'productionName', 'updatedAt']) &&
        request.resource.data.keys().hasAll(
          ['id', 'pid', 'kind', 'title', 'startsAt', 'productionName']) &&
        request.resource.data.pid is string &&
        request.resource.data.id is string &&
        sid == request.resource.data.pid + '_' + request.resource.data.id &&
        request.resource.data.kind == 'show' &&
        canDirect(request.resource.data.pid) &&
        existsAfter(eventPath(request.resource.data.pid, request.resource.data.id)) &&
        getAfter(eventPath(request.resource.data.pid, request.resource.data.id)).data.kind == 'show' &&
        getAfter(eventPath(request.resource.data.pid, request.resource.data.id)).data.title == request.resource.data.title &&
        getAfter(eventPath(request.resource.data.pid, request.resource.data.id)).data.startsAt == request.resource.data.startsAt &&
        request.resource.data.productionName == prod(request.resource.data.pid).name;
    }

    // First admin setup is allowed once; all later account creation is admin-controlled.
    match /meta/{doc} {
      allow read: if true;
      allow create: if signedIn() && !exists(/databases/$(database)/documents/meta/setup);
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.isAdmin == true &&
          !exists(/databases/$(database)/documents/meta/setup)) || isAdmin());
      allow update: if isAdmin() ||
        (request.auth.uid == uid && request.resource.data.isAdmin == resource.data.isAdmin);
      allow delete: if isAdmin();
    }

    match /notifications/{nid} {
      allow read: if signedIn() &&
        (resource.data.to == request.auth.uid || canDirect(resource.data.pid));
      allow create: if canDirect(request.resource.data.pid) &&
        request.resource.data.keys().hasOnly(
          ['id', 'type', 'pid', 'to', 'from', 'senderName', 'productionName', 'roles', 'character', 'status', 'read', 'createdAt']) &&
        request.resource.data.id == nid &&
        request.resource.data.type == 'production_invite' &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.to in prod(request.resource.data.pid).memberIds &&
        request.resource.data.roles is list &&
        request.resource.data.status == 'pending' &&
        request.resource.data.read == false;
      allow update: if signedIn() &&
        resource.data.to == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'read', 'respondedAt']) &&
        request.resource.data.status in ['pending', 'available', 'unavailable'] &&
        request.resource.data.read == true;
      allow delete: if canDirect(resource.data.pid);
    }

    // Public show listings contain no attendee IDs or RSVP data.
    match /publicShows/{sid} {
      allow read: if signedIn();
      allow create, update: if validPublicShow(sid);
      allow delete: if canDirect(resource.data.pid) &&
        (!existsAfter(eventPath(resource.data.pid, resource.data.id)) ||
         getAfter(eventPath(resource.data.pid, resource.data.id)).data.kind != 'show');
    }

    match /productions/{pid} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid in resource.data.memberIds);
      allow create: if isAdmin();
      allow update: if canDirect(pid);
      allow delete: if isAdmin();

      match /cues/{cid} {
        allow read: if isMember(pid);
        allow create: if isMember(pid) &&
          (canDirect(pid) || hasRole(pid, request.resource.data.dept));
        allow update: if isMember(pid) && (canDirect(pid) ||
          (hasRole(pid, resource.data.dept) &&
           request.resource.data.dept == resource.data.dept));
        allow delete: if isMember(pid) &&
          (canDirect(pid) || hasRole(pid, resource.data.dept));
      }

      match /notes/{nid} {
        allow read: if isMember(pid) &&
          (resource.data.author == request.auth.uid ||
           resource.data.get('to', '') == request.auth.uid);
        allow create: if isMember(pid) &&
          request.resource.data.author == request.auth.uid &&
          (!('to' in request.resource.data) ||
            (canDirect(pid) && request.resource.data.to in prod(pid).memberIds));
        allow update: if false;
        allow delete: if isMember(pid) && resource.data.author == request.auth.uid;
      }

      match /events/{eid} {
        allow read: if isMember(pid) &&
          (canDirect(pid) || request.auth.uid in resource.data.memberIds);
        allow create: if canDirect(pid) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.memberIds is list &&
          request.resource.data.memberIds.hasOnly(prod(pid).memberIds);
        allow update: if canDirect(pid) &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.memberIds is list &&
          request.resource.data.memberIds.hasOnly(prod(pid).memberIds);
        allow delete: if canDirect(pid);

        match /responses/{uid} {
          allow read: if canReadEvent(pid, eid);
          allow create, update: if canReadEvent(pid, eid) &&
            request.auth.uid == uid &&
            uid in get(eventPath(pid, eid)).data.memberIds &&
            request.resource.data.uid == uid &&
            request.resource.data.response in ['going', 'not-going'];
          allow delete: if canReadEvent(pid, eid) &&
            request.auth.uid == uid && uid in get(eventPath(pid, eid)).data.memberIds;
        }
      }

      match /scripts/{sid} {
        allow read: if isMember(pid);
        allow create, update, delete: if canDirect(pid) || hasRole(pid, 'writer');

        match /highlights/{uid} {
          allow read: if isMember(pid) && request.auth.uid == uid;
          allow create, update: if isMember(pid) && request.auth.uid == uid &&
            request.resource.data.uid == uid && request.resource.data.highlights is list;
          allow delete: if isMember(pid) && request.auth.uid == uid;
        }
      }
    }
  }
}
